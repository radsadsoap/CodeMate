# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas (or any MongoDB) connection string. The database name is set separately.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=codemate

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call the API and open sockets.
CLIENT_ORIGIN=http://localhost:5173

# Optional TURN relay for voice chat on strict networks (comma-separated URLs).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
