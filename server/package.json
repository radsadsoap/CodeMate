{
    "name": "codemate-server",
    "version": "1.0.0",
    "private": true,
    "description": "REST API and realtime server for CodeMate",
    "type": "module",
    "main": "server.js",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "node --watch-path=server.js --watch-path=config --watch-path=controllers --watch-path=middlewares --watch-path=models --watch-path=realtime --watch-path=routes --watch-path=utils server.js",
        "start": "node server.js",
        "smoke": "node scripts/smoke.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "lib0": "^0.2.117",
        "mongoose": "^8.17.1",
        "socket.io": "^4.8.1",
        "y-protocols": "^1.0.7",
        "yjs": "^13.6.33",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "socket.io-client": "^4.8.1"
    }
}
